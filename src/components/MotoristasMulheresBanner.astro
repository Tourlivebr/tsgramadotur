---
const message = 'Olá! Quero reservar um passeio com guia e motorista mulher para meu grupo ou família.';
const whatsappUrl = 'https://wa.me/5554996968659?text=' + encodeURIComponent(message);
---

<section class="women-banner" aria-labelledby="women-title">
  <img class="women-background" src="/images/banner_mulher.png" alt="" width="600" height="600" loading="lazy" decoding="async" />
  <div class="women-overlay" aria-hidden="true"></div>
  <div class="women-content container mx-auto px-4">
    <div class="women-copy">
      <p class="women-eyebrow"><span aria-hidden="true">&#10022;</span> Uma viagem com mais tranquilidade</p>
      <h2 id="women-title">Sua viagem em boas mãos<br /><span>com mulheres</span></h2>
      <p class="women-description">Guias e motoristas mulheres para atender grupos e famílias em Gramado e Canela.</p>
      <a class="women-button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" /></svg>
        Reserve pelo WhatsApp
        <span aria-hidden="true">&#8594;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .women-banner{position:relative;isolation:isolate;overflow:hidden;background:var(--clr-primary-950);color:var(--clr-cream-50)}
  .women-background,.women-overlay{position:absolute;inset:0;width:100%;height:100%;z-index:-1}
  .women-background{object-fit:cover;object-position:center 52%;filter:contrast(1.08) saturate(1.08)}
  .women-overlay{background:linear-gradient(90deg,rgba(0,18,56,.6),rgba(0,18,56,.68) 42%,rgba(0,18,56,.3))}
  .women-content{display:flex;align-items:center;min-height:340px;padding-top:44px;padding-bottom:44px;max-width:1200px}
  .women-copy{max-width:650px}
  .women-eyebrow{display:flex;align-items:center;gap:10px;color:var(--clr-accent-200);font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin:0 0 16px}
  .women-eyebrow span{font-size:24px}
  h2{font-size:clamp(30px,3vw,44px);font-weight:700;line-height:1.15;margin:0}
  h2 span{display:inline-block;font-family:Georgia,serif;color:var(--clr-accent-200);font-size:1.35em;line-height:1.05}
  .women-description{font-size:15px;line-height:1.65;max-width:430px;margin:14px 0 22px}
  .women-button{display:inline-flex;align-items:center;gap:12px;padding:15px 24px;background:var(--clr-accent-600);color:white;border:1px solid var(--clr-accent-300);border-radius:999px;font-weight:700;box-shadow:0 5px 24px color-mix(in srgb,var(--clr-primary-950) 25.1%,transparent);transition:background .2s}
  .women-button:hover{background:var(--clr-accent-700)}
  .women-button:focus-visible{outline:3px solid var(--clr-accent-200);outline-offset:5px}
  .women-button svg{width:24px;height:24px;flex-shrink:0}
  .women-button>span{margin-left:4px;font-size:22px}
  @media(max-width:767px){.women-content{min-height:320px;justify-content:center;padding:40px 24px}.women-copy{text-align:center;margin:auto}.women-eyebrow{justify-content:center;font-size:10px;letter-spacing:.08em}h2{font-size:30px}.women-description{font-size:14px}.women-button{font-size:14px;padding:14px 20px}.women-overlay{background:color-mix(in srgb,var(--clr-primary-950) 64%,transparent)}}
</style>
