---

<BaseLayout 
  title="Passeios e Translados | Passeios Gramado Canela - Gramado e Canela"
  description="Descubra os melhores passeios privativos, translados e receptivo em Gramado e Canela. Experiências únicas na Serra Gaúcha com a Passeios Gramado Canela!"
  keywords={['passeios Gramado', 'passeios Canela', 'translados Serra Gaúcha', 'passeios privativos RS', 'Passeios Gramado Canela']}
  image="/images/link_passeios1.jpg"
>
  <Header />
  
  <main class="pt-20 lg:pt-24">
<!-- Hero Section -->
<section 
  class="relative text-white py-8 lg:py-20 bg-center bg-cover bg-no-repeat bg-scroll lg:bg-local"
  style="background-image: url('/images/link_passeios1.jpg'); filter: brightness(1.05) contrast(1.1) saturate(1.2);"
>
  <!-- Overlay branco bem leve só pra não perder legibilidade -->
  <div class="absolute inset-0 bg-white/10"></div>

  <div class="relative container mx-auto px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-5xl lg:text-7xl font-bold mb-6 leading-tight">Translados e Passeios</h1>
      <p class="text-xl lg:text-2xl text-white/90 mb-8 leading-relaxed">
        Experiências autênticas e inesquecíveis na região colonial
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <div class="flex items-center text-white/90">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          Guia especializado
        </div>
        <div class="flex items-center text-white/90">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          Transporte incluso
        </div>
        <div class="flex items-center text-white/90">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          Experiência personalizada
        </div>
      </div>
    </div>
  </div>

  <!-- Divisor Boleado Suave -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] z-20">
    <svg 
      viewBox="0 0 1200 120" 
      preserveAspectRatio="none" 
      class="relative block w-[calc(100%+1.3px)] h-[30px] lg:h-[50px]"
    >
      <path d="M0,0 C300,120 900,120 1200,0 L1200,120 L0,120 Z" class="fill-dark-50 dark:fill-dark-900"></path>
    </svg>
  </div>
</section>


    <!-- Filtros -->
    <section class="py-6 bg-gradient-to-r from-dark-50 to-dark-100 dark:from-dark-900 dark:to-dark-800">
      <div class="container mx-auto px-4">
      </div>
    </section>

    <!-- Grid de Passeios (estrutura IDENTICA aos cards da home) -->
    <section class="py-20 bg-gradient-to-b from-white to-dark-50 dark:from-dark-900 dark:to-dark-800">
      <div class="container mx-auto px-4">
        <div id="passeios-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {passeios.map((passeio) => (
            <div class="passeio-card h-full group" data-category={passeio.categoria.toLowerCase().replace(' ', '-').replace('passeios-privativos', 'privativos')}>
            <div class="bg-white dark:bg-dark-800 rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 border border-dark-100 dark:border-dark-700 h-full flex flex-col">
              <div class="relative h-52 lg:h-56 overflow-hidden">
                <img 
                  src={passeio.imagem} 
                  alt={passeio.titulo}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute top-3 left-3">
                  <span class="bg-primary-600 text-white text-sm font-semibold px-3 py-1.5 rounded-full shadow backdrop-blur-sm">
                    {passeio.categoria}
                  </span>
                </div>
                {passeio.totalAvaliacoes > 0 && <div class="absolute top-3 right-3 bg-white/90 dark:bg-dark-900/80 backdrop-blur-sm rounded-full px-3 py-1.5 text-sm font-semibold text-dark-700 dark:text-dark-200 shadow">
                  ⭐ {passeio.avaliacao}
                </div>}
              </div>
              
              <div class="p-4 lg:p-5 flex flex-col flex-1 gap-3">
                <div class="flex items-center justify-between">
                  {passeio.totalAvaliacoes > 0 ? <div class="flex items-center gap-1">
                    <StarRating rating={passeio.avaliacao} />
                    <span class="text-sm text-dark-500 dark:text-dark-400 ml-1 font-medium">({passeio.totalAvaliacoes})</span>
                  </div> : <span class="text-sm text-dark-500 dark:text-dark-400">Novo transfer</span>}
                  <span class="text-sm font-medium text-dark-500 dark:text-dark-400 whitespace-nowrap">
                    ⏱ {passeio.duracao}
                  </span>
                </div>
                
                <h3 class="font-bold text-2xl lg:text-xl text-dark-900 dark:text-white leading-tight line-clamp-2 group-hover:text-primary-600 transition-colors duration-200">
                  {passeio.titulo}
                </h3>
                <p class="text-dark-600 dark:text-dark-400 text-lg lg:text-base leading-relaxed line-clamp-2 flex-1">
                  {passeio.subtitulo}
                </p>
                
                <div class="flex flex-wrap gap-2 mt-2 mb-2">
                  {passeio.tags && passeio.tags.slice(0, 2).map(tag => (
                    <span class="px-3 py-1 bg-primary-50 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full text-sm font-medium line-clamp-1">
                      {tag}
                    </span>
                  ))}
                </div>
                
                <div class="border-t border-dark-100 dark:border-dark-700 pt-4 space-y-3">
                  <div class="grid grid-cols-2 gap-3">
                    {[{label:passeio.label1,preco:passeio.price1}, ...('price3' in passeio ? [{label:passeio.label3,preco:passeio.price3}] : []), {label:passeio.label2,preco:passeio.price2}].map((faixa) => (
                      <div class="bg-dark-50 dark:bg-dark-700/50 rounded-lg p-2 text-center">
                        <p class="text-xs text-dark-500 dark:text-dark-400 font-medium">{faixa.label}</p>
                        <p class="text-lg font-bold text-primary-600 dark:text-primary-400 mt-1">{faixa.preco.toLocaleString('pt-BR', {style:'currency',currency:'BRL'})}</p>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="flex flex-col gap-2 mt-auto">
                  <a
                    href={`/passeio/${passeio.slug}`}
                    class="w-full bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 px-4 rounded-full transition-colors duration-200 block text-center text-base shadow-md"
                  >
                    <span class="flex items-center justify-center">
                      RESERVE AGORA
                    </span>
                  </a>
                  
                  <a
                    href={`https://wa.me/5554996968659?text=${encodeURIComponent(passeio.whatsappText || `Olá! Gostaria de reservar o passeio: ${passeio.titulo}`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full border-2 border-primary-600 hover:bg-primary-50 dark:hover:bg-primary-900/20 text-primary-700 dark:text-primary-300 font-semibold py-3 px-4 rounded-xl transition-colors duration-200 block text-center text-base"
                  >
                    <span class="flex items-center justify-center">
                      SAIBA MAIS
                    </span>
                  </a>
                </div>
              </div>
            </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Filtros
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      // Remove active de todos os botões
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('bg-primary-600', 'text-white');
        b.classList.add('bg-dark-200', 'text-dark-700', 'dark:bg-dark-700', 'dark:text-dark-300');
      });
      
      // Adiciona active ao botão clicado
      btn.classList.remove('bg-dark-200', 'text-dark-700', 'dark:bg-dark-700', 'dark:text-dark-300');
      btn.classList.add('bg-primary-600', 'text-white');
      
      const filter = btn.dataset.filter;
      const cards = document.querySelectorAll('.passeio-card');
      
      cards.forEach(card => {
        if (filter === 'all' || card.dataset.category === filter) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>